---
import '@/styles/common.scss';
import CommonLayout from '@/components/Common/CommonLayout.astro';
import Head from '@/components/Common/CommonHead.astro';
import JsonLd from '@/components/Common/JsonLD/JsonLd.astro';
import type { BreadcrumbItem } from '@/components/Common/CommonBreadcrumb.astro';

interface Props {
  title: string;
  description: string;
  breadcrumb?: BreadcrumbItem[];
}

const { title, description, breadcrumb }: Props = Astro.props;
---

<!doctype html>
<html lang="ja">
  <Head title={title} description={description}>
    <script src="@/scripts/common.ts"></script>
    <JsonLd />
    <slot name="head" />
  </Head>
  <body>
    <CommonLayout breadcrumb={breadcrumb}>
      <slot />
    </CommonLayout>
  </body>
</html>
