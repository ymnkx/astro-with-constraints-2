---
import type { HTMLTag, Polymorphic } from 'astro/types';

type Props<Tag extends Extract<HTMLTag, 'h1' | 'h2' | 'h3' | 'h4' | 'h5' | 'h6'> = 'h2'> = Polymorphic<{
  as: Tag;
}>;
const { as: Tag = 'h2', class: className, ...rest }: Props = Astro.props;
---

<Tag class:list={[className, 'parts-heading']} {...rest}>
  <slot />
</Tag>
