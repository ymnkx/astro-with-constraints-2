---
// フォーム項目のラベル・必須バッジ・入力欄をまとめる汎用ラッパー
interface Props {
  label: string;
  required?: boolean;
  htmlFor?: string;
  as?: 'div' | 'fieldset';
  error?: string; // 入力エラー時に表示する文言
}

const { label, required = false, htmlFor, as = 'div', error } = Astro.props as Props;
const isFieldset = as === 'fieldset';
---

{
  isFieldset ? (
    <fieldset class="parts-formField">
      <legend class="parts-formField_legend">
        <span class="parts-formField_label">
          <span class="parts-formField_labelText">{label}</span>
          {required && <span class="parts-formField_badge">必須</span>}
        </span>
      </legend>
      <div class="parts-formField_control">
        <slot />
        {error && <p class="parts-formField_error">{error}</p>}
      </div>
    </fieldset>
  ) : (
    <div class="parts-formField">
      <label class="parts-formField_label" for={htmlFor}>
        <span class="parts-formField_labelText">{label}</span>
        {required && <span class="parts-formField_badge">必須</span>}
      </label>
      <div class="parts-formField_control">
        <slot />
        {error && <p class="parts-formField_error">{error}</p>}
      </div>
    </div>
  )
}
