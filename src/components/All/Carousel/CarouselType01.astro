---
import { parse } from 'node-html-parser';
import CarouselPagination from './CarouselPagination.astro';
import CrouselControls from './CrouselControls.astro';
const html = await Astro.slots.render('default');
const items = parse(html).childNodes.filter((item) => item.rawTagName !== '');
---

<div class="carousel-wrapper">
  <div class="embla">
    <div class="embla__container">
      {
        items.map((item: any) => (
          <div class="embla__slide">
            <Fragment set:html={item} />
          </div>
        ))
      }
    </div>
    <CrouselControls />
    <CarouselPagination />
  </div>
</div>
